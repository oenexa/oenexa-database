# ==============================================================================
# OENEXA Enterprise Database Platform — Environment Variables Template
# Generate high-entropy secrets for production deployment
# ==============================================================================

# Master Superuser Credentials (Internal DBA Admin Only)
POSTGRES_DB=oenexa_master
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_64_char_high_entropy_secret_key_postgres

# 1. Sovereign Identity & Access Management (oenexa-identity)
IDENTITY_DB_NAME=oenexa_identity_db
IDENTITY_DB_USER=oenexa_identity_app
IDENTITY_DB_PASSWORD=replace_with_32_char_secret_identity_db

# 2. Multi-Asset Custody & Wallet (oenexa-wallet)
WALLET_DB_NAME=oenexa_wallet_db
WALLET_DB_USER=oenexa_wallet_app
WALLET_DB_PASSWORD=replace_with_32_char_secret_wallet_db

# 3. Tri-Rail Payment Gateway (oenexa-pay)
PAY_DB_NAME=oenexa_pay_db
PAY_DB_USER=oenexa_pay_app
PAY_DB_PASSWORD=replace_with_32_char_secret_pay_db

# 4. High-Performance Matching Engine & Orderbook (oenexa-exchange)
EXCHANGE_DB_NAME=oenexa_exchange_db
EXCHANGE_DB_USER=oenexa_exchange_app
EXCHANGE_DB_PASSWORD=replace_with_32_char_secret_exchange_db

# 5. Automated Market Maker & Liquidity (oenexa-liquidity)
LIQUIDITY_DB_NAME=oenexa_liquidity_db
LIQUIDITY_DB_USER=oenexa_liquidity_app
LIQUIDITY_DB_PASSWORD=replace_with_32_char_secret_liquidity_db

# 6. AI Central Intelligence & Swarm (oenexa-ai-core, oenexa-agents, oenexa-rag)
AI_DB_NAME=oenexa_ai_db
AI_DB_USER=oenexa_ai_app
AI_DB_PASSWORD=replace_with_32_char_secret_ai_db

# 7. Institutional Market Data & Oracles (oenexa-market-data)
MARKET_DATA_DB_NAME=oenexa_market_data_db
MARKET_DATA_DB_USER=oenexa_market_data_app
MARKET_DATA_DB_PASSWORD=replace_with_32_char_secret_market_data_db

# 8. PoS Consensus & Validators (oenexa-validator)
VALIDATOR_DB_NAME=oenexa_validator_db
VALIDATOR_DB_USER=oenexa_validator_app
VALIDATOR_DB_PASSWORD=replace_with_32_char_secret_validator_db

# 9. OenGo Quick-Commerce & Fleet (oengo-api, merchant, driver, customer, admin)
COMMERCE_DB_NAME=oengo_commerce_db
COMMERCE_DB_USER=oengo_app
COMMERCE_DB_PASSWORD=replace_with_32_char_secret_commerce_db

# Redis In-Memory Cache & Distributed Lock Engine
REDIS_PASSWORD=replace_with_64_char_secret_redis
