# ==============================================================================
# OENEXA Enterprise Database Platform — Environment Variables Template
# Generate high-entropy secrets for production deployment
# ==============================================================================

# Master Superuser Credentials (Internal Admin Only)
POSTGRES_DB=oenexa_master
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_64_char_high_entropy_secret_key_postgres

# 1. AI Central Intelligence & Swarm (oenexa-ai-core)
AI_DB_NAME=oenexa_ai_db
AI_DB_USER=oenexa_ai_app
AI_DB_PASSWORD=replace_with_32_char_secret_ai_db

# 2. OenGo Quick-Commerce & Relayer (oengo-api)
COMMERCE_DB_NAME=oengo_commerce_db
COMMERCE_DB_USER=oengo_app
COMMERCE_DB_PASSWORD=replace_with_32_char_secret_commerce_db

# 3. Sovereign Identity & Access Management (oenexa-identity)
IDENTITY_DB_NAME=oenexa_identity_db
IDENTITY_DB_USER=oenexa_identity_app
IDENTITY_DB_PASSWORD=replace_with_32_char_secret_identity_db

# 4. Tri-Rail Payment Gateway (oenexa-pay)
PAY_DB_NAME=oenexa_pay_db
PAY_DB_USER=oenexa_pay_app
PAY_DB_PASSWORD=replace_with_32_char_secret_pay_db

# Redis In-Memory Cache & Event Store
REDIS_PASSWORD=replace_with_64_char_secret_redis
